---
import type { SourceMark } from '../lib/sourceVendor';

interface Props {
	mark: SourceMark;
	/** 14 in lists, 16 on the article page. */
	size?: number;
}

const { mark, size = 14 } = Astro.props;
---

{
	mark.image ? (
		<img
			class="source-mark source-mark--portrait"
			src={mark.image}
			alt=""
			width={size}
			height={size}
			style={`--mark-size: ${size}px`}
			loading="lazy"
			decoding="async"
		/>
	) : mark.vendor ? (
		<img
			class="source-mark"
			src={`/images/vendors/${mark.vendor}.svg`}
			alt=""
			width={size}
			height={size}
			loading="lazy"
			decoding="async"
		/>
	) : (
		<span
			class="source-mark source-mark--letter"
			style={`--mark-size: ${size}px`}
			aria-hidden="true"
		>
			{mark.initial}
		</span>
	)
}
