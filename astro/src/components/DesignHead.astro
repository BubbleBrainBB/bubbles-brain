---
import { designTabs, type DesignTab } from '../lib/designLibrary';

interface Props {
	/** Which of the four Design pages is showing. */
	current: DesignTab;
}

// Design collects four kinds of reference — brand specs, component libraries, other people's
// pages, and writing. Each reads differently, so each gets its own page under one head.
const { current } = Astro.props;
---

<header class="rr-head">
	<nav class="rr-crumbs" aria-label="位置"><a href="/vibe-coding/">Vibe Coding</a> / Design</nav>
	<h1 class="rr-title" lang="en">Design</h1>
	<nav class="rr-tabs" aria-label="Design 分页">
		{
			designTabs.map((tab) => (
				<a href={tab.href} aria-current={tab.id === current ? 'page' : undefined}>
					{tab.label}
				</a>
			))
		}
	</nav>
	<slot />
</header>
