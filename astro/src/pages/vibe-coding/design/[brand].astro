---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { designBrandGroups, designBrands } from '../../../data/designBrands';
import { designIcon } from '../../../lib/designLibrary';
import '../../../styles/design-library.css';

export function getStaticPaths() {
	return designBrands.map((brand) => ({ params: { brand: brand.id }, props: { brand } }));
}

// One brand's DESIGN.md, read in order: what it looks like, its rules, colors, type, dos and
// don'ts, then the file itself. The specimens wear the brand's own colors and type; everything
// around them stays in the site's own type.
const { brand } = Astro.props;
const brandsById = new Map(designBrands.map((item) => [item.id, item]));
const order = designBrandGroups.flatMap((group) => group.brandIds);
const next = brandsById.get(order[(order.indexOf(brand.id) + 1) % order.length]!)!;

const rawFiles = import.meta.glob('../../../data/design-md/*.md', {
	query: '?raw',
	import: 'default',
	eager: true,
}) as Record<string, string>;
const rawContent = rawFiles[`../../../data/design-md/${brand.sourceFile}.md`] ?? '';
const rawLineCount = rawContent ? rawContent.trimEnd().split('\n').length : 0;
---

<BaseLayout
	title={`${brand.name} 的设计语言 · Vibe Coding Design · Bubble's Brain`}
	description={`${brand.name} 的 DESIGN.md：${brand.lede}`}
	canonicalPath={`/vibe-coding/design/${brand.id}/`}
	section="vibe-coding"
>
	<article class="design-brand" data-design-brand>
		<header class="design-brand__head">
			<nav class="rr-crumbs" aria-label="位置">
				<a href="/vibe-coding/">Vibe Coding</a> / <a href="/vibe-coding/design/">Design</a> / 品牌规范
			</nav>
			<div class="design-brand__title">
				<img src={designIcon(brand.id)} alt="" width="32" height="32" />
				<h1 lang="en">{brand.name}</h1>
				<span>{brand.category}</span>
			</div>
			<p class="design-brand__lede">{brand.lede}</p>
		</header>

		{
			brand.plate.strip && (
				<figure
					class:list={['design-brand__plate', brand.plate.bg !== '#ffffff' && 'is-filled']}
					style={`background:${brand.plate.bg}`}
				>
					<i style={`background:${brand.plate.strip}`} aria-hidden="true" />
					<span style={brand.plate.headlineStyle}>{brand.plate.headline}</span>
				</figure>
			)
		}

		<section class="design-brand__section" aria-labelledby="brand-points">
			<h2 id="brand-points">设计要点</h2>
			<div class="design-brand__points">
				{brand.philosophy.map((point) => <p>{point}</p>)}
			</div>
		</section>

		<section class="design-brand__section" aria-labelledby="brand-colors">
			<h2 id="brand-colors">颜色</h2>
			<ul class="design-brand__colors">
				{
					brand.colors.map((color) => (
						<li>
							<i style={`background:${color.hex}`} aria-hidden="true" />
							<span class="design-brand__color-head">
								<span>{color.name}</span>
								<button type="button" data-copy-hex={color.hex} title={`复制 ${color.hex}`}>
									{color.hex}
								</button>
							</span>
							<span class="design-brand__color-role">{color.role}</span>
						</li>
					))
				}
			</ul>
		</section>

		<section class="design-brand__section" aria-labelledby="brand-type">
			<h2 id="brand-type">字体</h2>
			<div class="design-brand__type" style={brand.typePanelStyle}>
				{
					brand.typeScale.map((row) => (
						<div>
							<span style={row.style}>{row.sample}</span>
							<small>{row.spec}</small>
						</div>
					))
				}
			</div>
			<p class="design-brand__note">品牌自己的专有字体，这里用系统字体近似显示。</p>
		</section>

		<section class="design-brand__section" aria-labelledby="brand-rules">
			<h2 id="brand-rules">该做和别做</h2>
			<div class="design-brand__rules">
				<div>
					<h3>该做</h3>
					<ul class="design-brand__do">{brand.dos.map((item) => <li>{item}</li>)}</ul>
				</div>
				<div>
					<h3>别做</h3>
					<ul class="design-brand__dont">{brand.donts.map((item) => <li>{item}</li>)}</ul>
				</div>
			</div>
		</section>

		<section class="design-brand__section" aria-labelledby="brand-raw">
			<h2 id="brand-raw">DESIGN.md 原文</h2>
			<p>
				{brand.sourceFile}/DESIGN.md，{rawLineCount} 行。放进项目根目录，Claude Code 和 Cursor 会照着它写界面。
			</p>
			<div class="design-brand__raw-actions">
				<button type="button" class="design-brand__button is-primary" data-copy-raw>复制全文</button
				>
				<button type="button" class="design-brand__button" data-raw-toggle aria-expanded="false">
					展开原文
				</button>
			</div>
			<pre class="design-brand__raw" tabindex="0" data-raw-content hidden>{rawContent}</pre>
			<p class="design-brand__credit">
				原文来自社区项目 <a
					href="https://github.com/VoltAgent/awesome-design-md"
					rel="noopener"
					target="_blank">awesome-design-md</a
				>（VoltAgent，MIT
				协议），是对品牌公开页面的第三方分析，不是官方资料，原文里的品牌名故意写成了变体。本页的中文说明是原创的。
			</p>
		</section>

		<nav class="design-work-pager" aria-label="下一个品牌">
			<a href="/vibe-coding/design/">
				<span>← 回到</span>
				<strong>品牌规范</strong>
			</a>
			<a class="design-work-pager__next" href={`/vibe-coding/design/${next.id}/`}>
				<span>下一个 →</span>
				<strong>{next.name}</strong>
			</a>
		</nav>
	</article>
</BaseLayout>

<script>
	import '../../../scripts/designBrandPage';
</script>
