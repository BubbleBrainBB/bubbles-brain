---
import DesignHead from '../../../components/DesignHead.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import '../../../styles/design-library.css';
import { designBrandGroups, designBrands } from '../../../data/designBrands';

const brandsById = new Map(designBrands.map((brand) => [brand.id, brand]));
const groups = designBrandGroups.map((group) => ({
	...group,
	brands: group.brandIds.flatMap((id) => {
		const brand = brandsById.get(id);
		return brand ? [brand] : [];
	}),
}));
---

<BaseLayout
	title="Design · Vibe Coding · Bubble's Brain"
	description="大公司如何用 DESIGN.md 描述自己的视觉语言：色彩、字体、组件规则与设计哲学。"
>
	<div class="rr-page rr-page--wide" data-reading-directory>
		<DesignHead current="brands">
			<div class="rr-filters" role="group" aria-label="按分组">
				<button type="button" data-reading-filter="" aria-pressed="true">全部</button>
				{
					groups.map((group) => (
						<button type="button" data-reading-filter={group.id} aria-pressed="false">
							{group.label}
						</button>
					))
				}
			</div>
		</DesignHead>

		{
			groups.map((group) => (
				<section
					class="rr-block"
					id={group.id}
					data-reading-group={group.id}
					aria-labelledby={`design-${group.id}`}
				>
					<div class="rr-block__head">
						<h2 class="rr-block__title" id={`design-${group.id}`}>
							{group.label}
						</h2>
					</div>
					<ul class="rr-names rr-names--three">
						{group.brands.map((brand) => (
							<li data-reading-item>
								<a class="rr-name rr-name--block" href={`/vibe-coding/design/${brand.id}/`}>
									<span class="rr-name__main">{brand.name}</span>
									<span class="rr-name__sub">
										{brand.category} · {brand.tagline}
									</span>
								</a>
							</li>
						))}
					</ul>
				</section>
			))
		}
	</div>
</BaseLayout>

<script>
	import '../../../scripts/readingDirectory';
</script>
