---
import DesignHead from '../../../components/DesignHead.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import '../../../styles/design-library.css';
import { designBrandGroups, designBrands } from '../../../data/designBrands';
import { designIcon } from '../../../lib/designLibrary';

const brandsById = new Map(designBrands.map((brand) => [brand.id, brand]));
const groups = designBrandGroups.map((group) => ({
	...group,
	brands: group.brandIds.flatMap((id) => {
		const brand = brandsById.get(id);
		return brand ? [brand] : [];
	}),
}));
---

<BaseLayout
	title="Design · Vibe Coding · Bubble's Brain"
	description="大公司如何用 DESIGN.md 描述自己的视觉语言：色彩、字体、组件规则与设计哲学。"
>
	<div class="rr-page rr-page--wide">
		<DesignHead current="brands" />

		{
			groups.map((group) => (
				<section class="rr-block" id={group.id} aria-labelledby={`design-${group.id}`}>
					<div class="rr-block__head">
						<h2 class="rr-block__title" id={`design-${group.id}`}>
							{group.label}
						</h2>
					</div>
					<ul class="design-links">
						{group.brands.map((brand) => (
							<li>
								<a class="design-link" href={`/vibe-coding/design/${brand.id}/`}>
									<img
										class="design-link__icon"
										src={designIcon(brand.id)}
										alt=""
										width="20"
										height="20"
										loading="lazy"
										decoding="async"
									/>
									<span class="design-link__head">
										<span class="design-link__name">{brand.name}</span>
										<span class="design-link__by">{brand.category}</span>
									</span>
									<span class="design-link__note">{brand.tagline}</span>
								</a>
							</li>
						))}
					</ul>
				</section>
			))
		}
	</div>
</BaseLayout>
