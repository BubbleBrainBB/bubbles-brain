---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { loadDirectoryData, seriesLessons, TUTORIAL_SERIES } from '../../lib/directories';
import { readingMinutes } from '../../lib/readingTime';

// A contents page like Design 文章: each series is a part, lessons are numbered in reading order
// with a dotted leader out to how long they take to read.
const data = await loadDirectoryData();
const series = TUTORIAL_SERIES.map((meta) => ({
	...meta,
	title: data.collection(meta.id)?.title ?? meta.id,
	lessons: seriesLessons(data, meta.id).map((lesson) => ({
		...lesson,
		minutes: readingMinutes(data.legacyByRoute.get(lesson.key)?.body ?? ''),
	})),
}));
---

<BaseLayout
	title="教程 · Bubble's Brain"
	description="从一个好问题开始，到让 Agent 替你把项目做出来。新手村、Codex、Pi Agent、WorkBuddy 四个系列。"
>
	<div class="rr-page">
		<header class="rr-head">
			<h1 class="rr-title">教程</h1>
		</header>

		<div class="rr-contents rr-contents--numbered">
			{
				series.map((item) => (
					<section class="rr-contents__part" id={item.id} aria-labelledby={`series-${item.id}`}>
						<h2 id={`series-${item.id}`}>
							<span>{item.level}</span>
							{item.title}
						</h2>
						<ol class="rr-contents__list">
							{item.lessons.map((lesson, index) => (
								<li>
									<a class="rr-contents__link" href={lesson.href}>
										<span class="rr-contents__row">
											<span class="rr-contents__num" aria-hidden="true">
												{String(index + 1).padStart(2, '0')}
											</span>
											<span class="rr-contents__title">{lesson.title}</span>
											<span class="rr-contents__dots" aria-hidden="true" />
											<span class="rr-contents__side">{lesson.minutes} 分钟</span>
										</span>
									</a>
								</li>
							))}
						</ol>
					</section>
				))
			}
		</div>
	</div>
</BaseLayout>
