---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SourceMark from '../../components/SourceMark.astro';
import { highlightsByMonth, loadDirectoryData, shortDate } from '../../lib/directories';

const data = await loadDirectoryData();
const months = highlightsByMonth(data);
const years = [...new Set(months.map((month) => month.year))];
---

<BaseLayout
	title="精选阅读 · Bubble's Brain"
	description="值得反复读的一手资料与深度文章。每篇都是精读或全译，附原文入口。"
	alternateHref="/en/highlights/"
>
	<div class="rr-page" data-reading-directory>
		<header class="rr-head">
			<h1 class="rr-title">精选阅读</h1>
			<div class="rr-filters" role="group" aria-label="按年份">
				<button type="button" data-reading-filter="" aria-pressed="true"> 全部 </button>
				{
					years.map((year) => (
						<button type="button" data-reading-filter={year} aria-pressed="false">
							{year}
						</button>
					))
				}
			</div>
		</header>

		<div class="rr-contents">
			{
				months.map((month) => (
					<section
						class="rr-contents__part"
						data-reading-group={month.year}
						aria-labelledby={`month-${month.key}`}
					>
						<h2 id={`month-${month.key}`}>
							<span>{month.year} 年</span>
							{month.month} 月
						</h2>
						<ol class="rr-contents__list">
							{month.entries.map(({ item, source, mark }) => (
								<li data-reading-item>
									<a
										class="rr-contents__link"
										href={item.href}
										target={item.external ? '_blank' : undefined}
										rel={item.external ? 'noopener noreferrer' : undefined}
									>
										<span class="rr-contents__row">
											<span class="rr-contents__title">{item.title}</span>
											<span class="rr-contents__dots" aria-hidden="true" />
											<span class="rr-contents__side">
												<SourceMark mark={mark} size={16} />
												{source}
												<span class="rr-contents__date">
													{shortDate(item.date)}
													{item.external && ' ↗'}
												</span>
											</span>
										</span>
									</a>
								</li>
							))}
						</ol>
					</section>
				))
			}
		</div>
		<figure class="rr-end">
			<img
				src="/images/cat-pose-1.jpg"
				alt="坐着的猫馆长"
				width="1100"
				height="765"
				loading="lazy"
			/>
			<figcaption>就这些了，下个月见。</figcaption>
		</figure>
	</div>
</BaseLayout>

<script>
	import '../../scripts/readingDirectory';
</script>
